{
  "name": "OPS_detect_churn_accounts_v1",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 24 }]
        }
      },
      "id": "node-trigger",
      "name": "Trigger diario 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.PIPEDRIVE_DOMAIN }}/api/v1/deals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "api_token", "value": "={{ $env.PIPEDRIVE_API_TOKEN }}" },
            { "name": "stage_id",  "value": "={{ $env.PIPEDRIVE_STAGE_RENEGOCIACION }}" },
            { "name": "status",    "value": "open" },
            { "name": "limit",     "value": "100" }
          ]
        }
      },
      "id": "node-pipedrive-fetch",
      "name": "Fetch deals Renegociación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extraer deals y calcular señales de riesgo\nconst deals = $input.first().json.data || [];\n\nconst results = deals.map(deal => {\n  const lastActivity = deal.last_activity_date ? new Date(deal.last_activity_date) : null;\n  const daysSinceActivity = lastActivity\n    ? Math.floor((Date.now() - lastActivity.getTime()) / 86400000)\n    : 999;\n\n  // Señales de riesgo (ajustar thresholds según datos reales de emBlue)\n  const signals = [];\n  if (daysSinceActivity > 30)  signals.push(`sin_actividad_${daysSinceActivity}d`);\n  if (deal.value < 1000)       signals.push('valor_bajo');\n  if (!deal.expected_close_date) signals.push('sin_fecha_cierre');\n\n  // Score simple basado en señales (invertir: más señales = score más bajo)\n  const baseScore = 100 - (signals.length * 20) - Math.min(daysSinceActivity, 50);\n  const score = Math.max(0, Math.min(100, baseScore));\n\n  const risk_level =\n    score < 30 ? 'critical' :\n    score < 50 ? 'high' :\n    score < 70 ? 'medium' : 'low';\n\n  return {\n    pipedrive_deal_id: deal.id,\n    account_name:      deal.title,\n    score,\n    risk_level,\n    signals,\n    days_since_activity: daysSinceActivity,\n    deal_value:          deal.value,\n    owner_name:          deal.owner_name,\n    expected_close_date: deal.expected_close_date,\n  };\n});\n\n// Solo retornar cuentas con riesgo medium/high/critical\nreturn results\n  .filter(r => r.risk_level !== 'low')\n  .sort((a, b) => a.score - b.score)\n  .map(item => ({ json: item }));"
      },
      "id": "node-score",
      "name": "Calcular health score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-critical",
              "leftValue": "={{ $json.risk_level }}",
              "rightValue": "critical",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "node-filter-critical",
      "name": "¿Es crítico?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/account_health",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "pipedrive_deal_id", "value": "={{ $json.pipedrive_deal_id }}" },
            { "name": "score",             "value": "={{ $json.score }}" },
            { "name": "risk_level",        "value": "={{ $json.risk_level }}" },
            { "name": "notes",             "value": "={{ JSON.stringify($json.signals) }}" }
          ]
        }
      },
      "id": "node-supabase-upsert",
      "name": "Guardar en Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/account_health",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "pipedrive_deal_id", "value": "={{ $json.pipedrive_deal_id }}" },
            { "name": "score",             "value": "={{ $json.score }}" },
            { "name": "risk_level",        "value": "={{ $json.risk_level }}" },
            { "name": "notes",             "value": "={{ JSON.stringify($json.signals) }}" }
          ]
        }
      },
      "id": "node-supabase-upsert-2",
      "name": "Guardar en Supabase (high/medium)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/csm_interactions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ deal_id: $json.pipedrive_deal_id, type: 'churn_risk', summary: `ALERTA CRÍTICA: ${$json.account_name} — score ${$json.score}/100, ${$json.days_since_activity} días sin actividad`, next_action: 'Llamar al cliente hoy. Identificar bloqueador principal.', next_date: new Date(Date.now() + 86400000).toISOString().split('T')[0] }) }}"
      },
      "id": "node-create-interaction",
      "name": "Crear interacción urgente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 420]
    },
    {
      "parameters": {
        "jsCode": "// Generar resumen de ejecución\nconst items = $input.all();\nconst critical = items.filter(i => i.json.risk_level === 'critical').length;\nconst high     = items.filter(i => i.json.risk_level === 'high').length;\nconst medium   = items.filter(i => i.json.risk_level === 'medium').length;\n\nreturn [{\n  json: {\n    run_at:   new Date().toISOString(),\n    critical,\n    high,\n    medium,\n    total_flagged: critical + high + medium,\n    summary: `Churn radar ejecutado: ${critical} críticas, ${high} altas, ${medium} medias`,\n  }\n}];"
      },
      "id": "node-summary",
      "name": "Generar resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300]
    }
  ],
  "connections": {
    "Trigger diario 08:00":         { "main": [[{ "node": "Fetch deals Renegociación",        "type": "main", "index": 0 }]] },
    "Fetch deals Renegociación":    { "main": [[{ "node": "Calcular health score",             "type": "main", "index": 0 }]] },
    "Calcular health score":        { "main": [[{ "node": "¿Es crítico?",                      "type": "main", "index": 0 }]] },
    "¿Es crítico?": {
      "main": [
        [{ "node": "Guardar en Supabase (high/medium)", "type": "main", "index": 0 }],
        [{ "node": "Guardar en Supabase",               "type": "main", "index": 0 }]
      ]
    },
    "Guardar en Supabase":              { "main": [[{ "node": "Crear interacción urgente", "type": "main", "index": 0 }]] },
    "Guardar en Supabase (high/medium)":{ "main": [[{ "node": "Generar resumen",           "type": "main", "index": 0 }]] },
    "Crear interacción urgente":        { "main": [[{ "node": "Generar resumen",           "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": ""
  },
  "tags": ["OPS", "churn", "pipedrive", "supabase"],
  "notes": "Ejecuta diariamente a las 08:00. Evalúa deals en etapa Renegociación, calcula health score, guarda en Supabase y crea interacciones urgentes para cuentas críticas. Requiere: PIPEDRIVE_API_TOKEN, PIPEDRIVE_STAGE_RENEGOCIACION, SUPABASE_URL, SUPABASE_SERVICE_KEY."
}
